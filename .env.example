# Fauxnance Trading Platform - Environment Configuration
# Copy this file to .env and set values appropriate for your environment
# For local Docker development, defaults in application.properties are usually sufficient
# For production, ensure all REQUIRED variables are explicitly set

# ============================================================================
# AUTHENTICATION & JWT (REQUIRED)
# ============================================================================

# JWT Secret for signing/verifying tokens
# REQUIRED: Must be at least 32 bytes (256 bits) of random data
# Generate: openssl rand -base64 32
# Used by: Nest Auth (generation), Trade API (verification), Trade Executor (verification)
JWT_SECRET=your_32_byte_secret_here_minimum_256_bits_of_entropy

# JWT Token Configuration
JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL_SECONDS=900              # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800          # 7 days

# ============================================================================
# DATABASE (REQUIRED)
# ============================================================================

# PostgreSQL Connection
# Used by: Nest Auth, Trade API, Trade Executor, Analytics ETL
POSTGRES_HOST=localhost                   # Docker: postgres | Local: localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_management              # Database name
POSTGRES_USER=postgres                    # Database user
POSTGRES_PASSWORD=change_me_in_production # REQUIRED: Change in production!

# Spring Boot Database Configuration
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ============================================================================
# KAFKA MESSAGING (REQUIRED)
# ============================================================================

# Kafka Bootstrap Servers
# Used by: Trade API (producer), Trade Executor (consumer)
# Docker: kafka:29092 (internal) | Local: localhost:8085 (external)
# Note: 10.8.75.70:8085 was team-specific; use localhost for dev, env var for prod
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}

# Alternative for local machine (Windows):
# KAFKA_BOOTSTRAP_SERVERS=localhost:8085

# Kafka Topic Names
KAFKA_ORDERS_TOPIC=orders
KAFKA_TRADE_EVENTS_TOPIC=trade-events
KAFKA_CONSUMER_GROUP_ID=trade-executor

# ============================================================================
# NEST AUTH SERVICE
# ============================================================================

# Nest Auth Server Configuration
# Used by: Nest Auth service
PORT=3000
NODE_ENV=development                      # development | production
LOG_LEVEL=debug                           # error | warn | info | debug

# Bcrypt Configuration
BCRYPT_COST=12                            # Hash computation cost (higher = slower)

# Throttle Configuration (Login Attempts)
LOGIN_THROTTLE_ATTEMPTS=5                 # Max attempts before throttling
LOGIN_THROTTLE_DURATION_MS=900000         # 15 minutes

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:3001

# ============================================================================
# TRADE API SERVICE
# ============================================================================

# Trade API Server Configuration
# Used by: Trade API service
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=platform           # local | platform

# Auth Service Discovery
# Updated: Uses NestJS auth service instead of legacy auth-stub
AUTH_STUB_BASE_URL=http://localhost:3000  # Docker: http://nest-auth:3000 | Local: http://localhost:3000

# Fauxnance Market Data API
# Legacy service for quote data
FAUXNANCE_API_KEY=your_fauxnance_api_key_here
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# ============================================================================
# TRADE EXECUTOR SERVICE
# ============================================================================

# Executor Server Configuration
# Used by: Trade Executor service
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=platform           # local | platform

# Kafka Consumer Configuration
KAFKA_CONSUMER_GROUP_ID=trade-executor
KAFKA_AUTO_OFFSET_RESET=earliest          # earliest | latest
KAFKA_ENABLE_AUTO_COMMIT=false            # Manual commit for reliability

# Retry Configuration
EXECUTOR_RETRY_INITIAL_INTERVAL_MS=100
EXECUTOR_RETRY_MAX_INTERVAL_MS=5000
EXECUTOR_RETRY_MULTIPLIER=2.0
EXECUTOR_RETRY_MAX_ATTEMPTS=3

# Market Data Polling
MARKET_DATA_POLL_INTERVAL_SECONDS=60      # Minimum 44s to stay within quota

# Settlement Configuration
SETTLEMENT_OPTIMISTIC_LOCK_MAX_RETRIES=3

# ============================================================================
# ANALYTICS ETL PIPELINE
# ============================================================================

# Analytics Configuration
# Used by: Analytics ETL service
DUCKDB_PATH=./databases/duckdb/analytics/analytics.duckdb  # Path to DuckDB database file
PYTHON_ENV=development                    # development | production

# ETL Pipeline Configuration
ETL_BATCH_SIZE=1000                       # Rows to process per batch
ETL_MAX_RETRIES=3                         # Retry attempts for failed extracts
ETL_REQUEST_TIMEOUT_SECONDS=30            # HTTP request timeout

# Default Date Range for Analytics
ANALYTICS_START_DATE=2025-08-01           # Historical data start
ANALYTICS_END_DATE=2025-09-30             # Historical data end

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Java Logging
SPRING_LOGGING_LEVEL_ROOT=INFO
SPRING_LOGGING_LEVEL_COM_TEAM5=DEBUG
SPRING_LOGGING_LEVEL_COM_NEUEDA=DEBUG
SPRING_LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_KAFKA=INFO
SPRING_LOGGING_LEVEL_ORG_APACHE_KAFKA=WARN

# Correlation ID for Request Tracing
ENABLE_CORRELATION_ID=true
CORRELATION_ID_HEADER=X-Correlation-ID

# ============================================================================
# DOCKER COMPOSE CONFIGURATION
# ============================================================================

# Kafka Host Configuration
# For external client connections (Windows machine accessing Docker Kafka)
KAFKA_HOST=localhost                      # Docker: leave unset (defaults to 10.8.64.174) | Local: localhost

# Compose Profiles
# Use: docker-compose --profile platform up -d
# Options: "platform" (full stack), "kafka-only" (Kafka + PostgreSQL only)

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Password Policy (Enforced in Nest Auth)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true
PASSWORD_SPECIAL_CHARS=!@#$%^&*()_+-=[]{}|;:,.<>?

# Session Configuration
SESSION_TIMEOUT_SECONDS=3600              # 1 hour

# ============================================================================
# MONITORING & HEALTH CHECKS
# ============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# DEVELOPMENT ONLY (Not for Production)
# ============================================================================

# Enable debug endpoints (local development only)
DEBUG_ENDPOINTS_ENABLED=false             # Set true only for local dev

# Test Data Seeding
SEED_TEST_DATA=false                      # Seed sample accounts/trades

# ============================================================================
# NOTES
# ============================================================================
#
# PRODUCTION DEPLOYMENT:
# 1. Change all REQUIRED variables (marked with REQUIRED comment)
# 2. Use strong, random passwords generated with: openssl rand -base64 32
# 3. Use secure Kafka bootstrap server (external, with proper networking)
# 4. Enable SSL/TLS for database connections
# 5. Set SPRING_PROFILES_ACTIVE=production
# 6. Disable debug endpoints
# 7. Enable monitoring/metrics
#
# DOCKER DEPLOYMENT:
# 1. Use docker-compose --profile platform up -d
# 2. Services auto-discover via Docker DNS (e.g., postgres:5432)
# 3. Kafka bootstrap server: kafka:29092 (internal Docker network)
# 4. No need to expose ports for inter-service communication
#
# LOCAL DEVELOPMENT:
# 1. Run services individually or use Docker Compose for infrastructure
# 2. Use localhost for all connections
# 3. Set SPRING_PROFILES_ACTIVE=local
# 4. Generate unique JWT_SECRET: openssl rand -base64 32
#

# =============================================================================
# NOTIFICATIONS: REAL EMAIL (OPTIONAL)
# =============================================================================
# Off by default: the EMAIL channel only logs. To send real email through Gmail:
#   1. Google account -> Security -> 2-Step Verification -> App passwords -> create one for "Mail"
#   2. Put your values in your own .env (never in this file, never committed)
# NOTIFICATIONS_EMAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=your16characterapppassword
# MAIL_FROM=your.address@gmail.com              # optional, defaults to MAIL_USERNAME
# NOTIFICATIONS_INBOX_URL=http://localhost:4200/notifications

# =============================================================================
# NOTIFICATIONS: BROWSER PUSH (OPTIONAL)
# =============================================================================
# Off by default: the PUSH channel only logs. To show real browser pop-ups (Chrome/Edge on
# http://localhost or https), generate a VAPID key pair once and put it in your own .env:
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('PUSH_VAPID_PUBLIC_KEY='+e.getPublicKey('base64url'));console.log('PUSH_VAPID_PRIVATE_KEY='+e.getPrivateKey('base64url'))"
# NOTIFICATIONS_PUSH_ENABLED=true
# PUSH_VAPID_PUBLIC_KEY=<87 characters>
# PUSH_VAPID_PRIVATE_KEY=<43 characters, keep secret>
# PUSH_VAPID_SUBJECT=mailto:your.address@gmail.com
