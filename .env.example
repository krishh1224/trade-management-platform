# Copy to .env in the repo root and fill in the values marked <...>.
# docker-compose reads .env and passes it to every backend container.
# .env is git-ignored; this template is safe to commit.

# --- Docker Compose
# Services started by a plain `docker-compose up -d`. Add localdb to run Postgres in Docker.
COMPOSE_PROFILES=kafka,auth-service,order-service,executor-service,frontend
# Topics created by kafka-init (the broker does not auto-create). name:partitions:retention_ms
KAFKA_TOPICS=orders:3:604800000 orders.DLT:1:604800000 trade-events:3:604800000 trade-events.DLT:1:604800000 market-data:3:604800000 market-data.DLT:1:604800000

# --- Database (all services, ETL)
# RDS endpoint, or `postgres` when running the localdb profile.
POSTGRES_HOST=<db-host>
POSTGRES_PORT=5432
POSTGRES_DB=<db-name>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>

# --- Auth / JWT (shared by auth-service, order-service, executor-service)
# At least 32 bytes. Generate: openssl rand -base64 32
JWT_SECRET=<at-least-32-byte-secret>
JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=60

# Signs orders placed by automated strategies (order-service). At least 32 bytes and
# different from JWT_SECRET. Empty = strategies cannot place orders.
STRATEGY_TOKEN_SECRET=<another-32-byte-secret>

# --- Spring services (order-service, executor-service)
SPRING_PROFILES_ACTIVE=platform

# --- Fauxnance market data (order-service, executor-service, ETL)
FAUXNANCE_API_KEY=<fnx_dev_...>
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# Executor quote polling in seconds (14400 = 4 hours). Minimum 44.
MARKET_DATA_POLL_INTERVAL_SECONDS=14400

# --- AI advisor (order-service). Empty key = advisor disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Notifications (order-service). Both channels only log while disabled.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false

# Real email through Gmail: set NOTIFICATIONS_EMAIL_ENABLED=true and uncomment.
# Needs a Gmail app password (Google account > Security > 2-Step Verification > App passwords).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=<16-character app password>
# MAIL_FROM=your.address@gmail.com

# Browser push: set NOTIFICATIONS_PUSH_ENABLED=true and uncomment. Generate the key pair once:
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('PUSH_VAPID_PUBLIC_KEY='+e.getPublicKey('base64url'));console.log('PUSH_VAPID_PRIVATE_KEY='+e.getPrivateKey('base64url'))"
# PUSH_VAPID_PUBLIC_KEY=<87 characters>
# PUSH_VAPID_PRIVATE_KEY=<43 characters>
# PUSH_VAPID_SUBJECT=mailto:your.address@gmail.com
