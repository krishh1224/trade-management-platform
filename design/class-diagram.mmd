classDiagram

%% ENTITIES
class Client {
    -Long id
    -String name
    -String email
    -String phone
    -LocalDate dob
    -LocalDateTime createdAt
    -LocalDateTime updatedAt
    +getId() Long
}

class Account {
    -Long accId
    -Long clientId
    -String accountNumber
    -RiskProfile riskProfile
    -String baseCurrency
    -BigDecimal balance
    -AccountStatus status
    -LocalDateTime createdAt
    -LocalDateTime updatedAt
    +canAfford(amount BigDecimal) boolean
    +debit(amount BigDecimal) void
    +credit(amount BigDecimal) void
    +isActive() boolean
    +freeze() void
}

class Portfolio {
    -Long portfolioId
    -String name
    -Long accountId
    -String status
    -LocalDateTime createdAt
    -LocalDateTime updatedAt
    +isActive() boolean
}

class Instrument {
    -Long instrumentId
    -String name
    -String ticker
    -String assetClass
    -String currency
    -Exchange exchange
    -boolean tradable
    +isTradable() boolean
}

class PortfolioHolding {
    -Long portfolioHoldingId
    -Long portfolioId
    -Long instrumentId
    -BigDecimal quantity
    -BigDecimal averageCost
    -LocalDateTime createdAt
    -LocalDateTime updatedAt
    +hasEnough(quantity BigDecimal) boolean
    +buy(quantity BigDecimal, price BigDecimal) void
    +sell(quantity BigDecimal) void
}

class Order {
    -Long orderId
    -Long portfolioId
    -Long instrumentId
    -BigDecimal quantity
    -BigDecimal price
    -OrderStatus status
    -OrderSide side
    -String idempotencyKey
    -LocalDateTime createdAt
    -LocalDateTime updatedAt
    -LocalDateTime expiresAt
    +fill() void
    +reject() void
    +cancel() void
}

class Transaction {
    -Long transactionId
    -Long accountId
    -Long orderId
    -Long instrumentId
    -TransactionType transactionType
    -BigDecimal quantity
    -BigDecimal price
    -BigDecimal amount
    -String currency
    -BigDecimal balanceBefore
    -BigDecimal balanceAfter
    -String idempotencyKey
    -LocalDateTime createdAt
    +isCashTransaction() boolean
    +isTradeTransaction() boolean
}

%% ENUMERATIONS

class AccountStatus {
    <<enumeration>>
    ACTIVE
    FROZEN
}

class RiskProfile {
    <<enumeration>>
    LOW
    MODERATE
    ADVENTUROUS
}

class OrderSide {
    <<enumeration>>
    BUY
    SELL
}

class OrderStatus {
    <<enumeration>>
    NEW
    FILLED
    REJECTED
    CANCELLED
}

class TransactionType {
    <<enumeration>>
    BUY
    SELL
    DEPOSIT
    WITHDRAWAL
}

class Exchange {
    <<enumeration>>
    NSE
    BSE
}

%% EXCEPTION HIERARCHY

class TradeDomainException {
    <<abstract>>
}

class AccountNotFoundException

class AccountNotActiveException

class InstrumentNotFoundException

class InsufficientFundsException

class InsufficientHoldingsException

class DuplicateOrderException

%% ENTITY RELATIONSHIPS

Client "1" --> "0..*" Account : owns

Account "1" --> "0..*" Portfolio : has

Portfolio "1" --> "0..*" PortfolioHolding : contains

Instrument "1" --> "0..*" PortfolioHolding : held as

Portfolio "1" --> "0..*" Order : receives

Instrument "1" --> "0..*" Order : ordered for

Account "1" --> "0..*" Transaction : records

Order "0..1" --> "0..*" Transaction : generates

Instrument "0..1" --> "0..*" Transaction : involves

%% ENUM RELATIONSHIPS

Account --> AccountStatus
Account --> RiskProfile
Instrument --> Exchange
Order --> OrderSide
Order --> OrderStatus
Transaction --> TransactionType

%% EXCEPTION INHERITANCE

TradeDomainException <|-- AccountNotFoundException
TradeDomainException <|-- AccountNotActiveException
TradeDomainException <|-- InstrumentNotFoundException
TradeDomainException <|-- InsufficientFundsException
TradeDomainException <|-- InsufficientHoldingsException
TradeDomainException <|-- DuplicateOrderException


