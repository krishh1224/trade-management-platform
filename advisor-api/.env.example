# advisor-api settings. Copy this file to .env in the same folder and fill in the values.
# .env is git-ignored; never commit real keys or passwords.
# Spring reads .env as a properties file: KEY=value, no quotes, no spaces around "=".

# --- Gemini (required) ---
# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Login tokens (required) ---
# Must be the same secret as trade-api and nest-auth, so their tokens are accepted here.
# At least 32 characters for HS256.
JWT_SECRET=same-value-as-trade-api-and-nest-auth

# --- Database (required) ---
# The shared trade_management database. The advisor only reads from it.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trade_management
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-postgres-password

# --- Optional (defaults shown) ---
# Gemini model. gemini-2.5-flash is closed to new API keys.
# GEMINI_MODEL=gemini-3.8-flash
# Port the service listens on.
# ADVISOR_PORT=8083
# Token checks; only change these if trade-api's settings change too.
# AUTH_JWT_ALGORITHM=HS256
# AUTH_JWT_ISSUER=auth-service
