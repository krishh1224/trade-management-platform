# Copy to .env for local (non-Docker) runs. Never commit the real .env.
PORT=3000

# Must be at least 32 bytes; the service refuses to start otherwise.
JWT_SECRET=replace-with-a-secret-of-at-least-32-bytes

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace
