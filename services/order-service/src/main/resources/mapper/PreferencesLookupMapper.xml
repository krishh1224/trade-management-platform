<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team5.preferences.PreferencesLookupMapper">

  <select id="findStoredAlertChannel" resultType="java.lang.String">
    SELECT alert_channel::text
    FROM customer_preferences
    WHERE acc_id = #{accountId}
  </select>

</mapper>
