sequenceDiagram

actor Caller

participant Service as OrderService
participant AccountRepo as AccountRepository
participant PortfolioRepo as PortfolioRepository
participant InstrumentRepo as InstrumentRepository
participant HoldingRepo as PortfolioHoldingRepository
participant Idempotency as IdempotencyChecker

participant Account
participant Portfolio
participant Instrument
participant Holding as PortfolioHolding
participant Order
participant Transaction


%% REQUEST ARRIVES

Caller->>Service: placeOrder(request)


%% RULE 1 - ACCOUNT EXISTS

Service->>AccountRepo: findById(accountId)

alt Account does not exist

AccountRepo-->>Service: null

Service-->>Caller: AccountNotFoundException

else Account exists

AccountRepo-->>Service: Account


%% RULE 2 - ACCOUNT ACTIVE

Service->>Account: isActive()

alt Account is FROZEN

Account-->>Service: false

Service-->>Caller: AccountNotActiveException

else Account is ACTIVE

Account-->>Service: true

%% FIND PORTFOLIO

Service->>PortfolioRepo: findByAccountId(accountId)

PortfolioRepo-->>Service: Portfolio

%% RULE 3 - INSTRUMENT EXISTS / TRADABLE

Service->>InstrumentRepo: findByTicker(symbol)

alt Instrument does not exist

InstrumentRepo-->>Service: null

Service-->>Caller: InstrumentNotFoundException

else Instrument exists

InstrumentRepo-->>Service: Instrument

Service->>Instrument: isTradable()

alt Instrument is not tradable

Instrument-->>Service: false

Service-->>Caller: InstrumentNotFoundException

else Instrument is tradable

Instrument-->>Service: true


%% RULE 4 - QUANTITY VALID

alt Quantity is invalid

Service-->>Caller: Reject invalid quantity

else Quantity is valid


%% RULE 5 - PRICE VALID

alt Price is invalid

Service-->>Caller: Reject invalid price

else Price is valid


%% BUY ORDER

alt side = BUY

Service->>Account: canAfford(quantity × price)

alt Insufficient funds

Account-->>Service: false

Service-->>Caller: InsufficientFundsException

else Sufficient funds

Account-->>Service: true


%% RULE 8 - IDEMPOTENCY

Service->>Idempotency: exists(idempotencyKey)

alt Duplicate order

Idempotency-->>Service: true

Service-->>Caller: DuplicateOrderException

else New order

Idempotency-->>Service: false


%% ATOMIC DOMAIN UPDATE

Service->>Account: debit(totalAmount)

Service->>HoldingRepo: find(portfolioId, instrumentId)

HoldingRepo-->>Service: Holding

alt Holding exists

Service->>Holding: buy(quantity, price)

else No existing holding

Service->>Holding: create new holding

Service->>Holding: buy(quantity, price)

end


Service->>Order: create BUY order

Service->>Order: fill()

Service->>Transaction: record BUY transaction

Service-->>Caller: Order FILLED

end
end


%% SELL ORDER

else side = SELL

Service->>HoldingRepo: find(portfolioId, instrumentId)

alt No holding exists

HoldingRepo-->>Service: null

Service-->>Caller: InsufficientHoldingsException

else Holding exists

HoldingRepo-->>Service: Holding

Service->>Holding: hasEnough(quantity)


alt Insufficient holdings

Holding-->>Service: false

Service-->>Caller: InsufficientHoldingsException

else Sufficient holdings

Holding-->>Service: true


%% RULE 8 - IDEMPOTENCY

Service->>Idempotency: exists(idempotencyKey)

alt Duplicate order

Idempotency-->>Service: true

Service-->>Caller: DuplicateOrderException

else New order

Idempotency-->>Service: false


%% ATOMIC DOMAIN UPDATE

Service->>Holding: sell(quantity)

Service->>Account: credit(totalAmount)

Service->>Order: create SELL order

Service->>Order: fill()

Service->>Transaction: record SELL transaction

Service-->>Caller: Order FILLED

end
end
end
end

end
end
end
end
end
end