{
  "name": "trade-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "generate:api": "ng-openapi-gen -c api-gen/trade-api.json && ng-openapi-gen -c api-gen/auth-api.json",
    "check:api": "npm run generate:api && git diff --exit-code -- src/app/api/generated"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^18.0.5",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
