# Fill in after the LBs exist (guide 7.5). Format: http://<load-balancer-dns>:<port>
# Each LB listens on its Service port: auth 3000, order 8081, executor 8082, frontend 80.
# Get the current addresses with:  kubectl get svc
FRONTEND_URL=http://adc443773b8114f7792813b3bf990dbb-954244175.ap-south-1.elb.amazonaws.com
AUTH_SERVICE_URL=http://a6182d2f1c8bd46fcb09f149ad078a3a-1627787524.ap-south-1.elb.amazonaws.com:3000
ORDER_SERVICE_URL=http://aae65c8e090004b318a2c8fb9a1ee77b-844729817.ap-south-1.elb.amazonaws.com:8081
EXECUTOR_SERVICE_URL=http://a57675265f1164eb08673da88adc58f1-1726670728.ap-south-1.elb.amazonaws.com:8082
# Read by auth-service and order-service: browser origins allowed to call them (comma-separated).
CORS_ALLOWED_ORIGINS=http://adc443773b8114f7792813b3bf990dbb-954244175.ap-south-1.elb.amazonaws.com
# Read by the frontend at start: replaces the API addresses built into the page (from=to, space-separated).
URL_REWRITES=http://localhost:3000=http://a6182d2f1c8bd46fcb09f149ad078a3a-1627787524.ap-south-1.elb.amazonaws.com:3000 http://localhost:8081=http://aae65c8e090004b318a2c8fb9a1ee77b-844729817.ap-south-1.elb.amazonaws.com:8081
