# Fill in after the ALB exists (guide 8.3), or write your own domain here first.
# With one hostname all three are the same origin and have NO port.
FRONTEND_URL=http://alb-address-pending.invalid
AUTH_SERVICE_URL=http://alb-address-pending.invalid
ORDER_SERVICE_URL=http://alb-address-pending.invalid
# Read by auth-service and order-service: browser origins allowed to call them (comma-separated).
CORS_ALLOWED_ORIGINS=http://alb-address-pending.invalid
# Read by the frontend at start: points both APIs at the ALB (from=to, space-separated).
URL_REWRITES=http://localhost:3000=http://alb-address-pending.invalid http://localhost:8081=http://alb-address-pending.invalid
