# SECRETS. Copy to secrets.env (git-ignored) and fill in. Copied to base/secrets.env and turned into the Secret etp-secrets (guide 7.2).
# Jenkins CD uploads this same file as the Secret file credential "secrets-env"; every key below must have a value.
# Postgres/RDS password (auth-service reads POSTGRES_PASSWORD, order/executor read SPRING_DATASOURCE_PASSWORD) - same value for both
POSTGRES_PASSWORD=
SPRING_DATASOURCE_PASSWORD=
# at least 32 bytes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
STRATEGY_TOKEN_SECRET=
FAUXNANCE_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional: enables the advisor chat in order-service
GEMINI_API_KEY=
