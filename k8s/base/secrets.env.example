# SECRETS. Copy to secrets.env (git-ignored) and fill in. Copied to base/secrets.env and turned into the Secret etp-secrets (guide 7.2).
# Same database password three times: auth + order read POSTGRES_PASSWORD, executor reads
# SPRING_DATASOURCE_PASSWORD, optional/postgres reads DB_PASSWORD.
POSTGRES_PASSWORD=replace-me
SPRING_DATASOURCE_PASSWORD=replace-me
DB_PASSWORD=replace-me
# at least 32 bytes:  openssl rand -base64 32
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-bytes
# at least 32 bytes and different from JWT_SECRET. Empty = strategies cannot place orders.
STRATEGY_TOKEN_SECRET=
FAUXNANCE_API_KEY=replace-me
# empty = advisor disabled
GEMINI_API_KEY=
