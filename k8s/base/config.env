# NON-SECRET settings for auth / order / executor (ConfigMap etp-config). Edit, then kubectl apply -k k8s/.build:
# the ConfigMap name carries a hash, so pods restart by themselves when this file changes.
# Names match what the services read (same as the root .env used by docker-compose).
# Secrets (passwords, JWT secrets, API keys) are NOT here: see secrets.env.

# ---- Spring profile (order-service, executor-service). Without it they start in "local" and fail.
SPRING_PROFILES_ACTIVE=platform

# ---- database (existing RDS instance) ----
POSTGRES_HOST=database-1.cxmygi0w0y9d.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Java services. Trade tables live in "public"; auth-service uses the "auth" schema by name.
SPRING_DATASOURCE_URL=jdbc:postgresql://database-1.cxmygi0w0y9d.ap-south-1.rds.amazonaws.com:5432/postgres?currentSchema=public&sslmode=require
# auth-service (node-postgres): encrypt, skip CA check. RDS rejects unencrypted connections.
PGSSLMODE=no-verify
# Only read by optional/postgres (in-cluster database instead of RDS).
DB_NAME=postgres
DB_USER=postgres

# ---- kafka (the StatefulSet in kafka.yaml) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- auth / JWT ----
JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=60

# ---- market data ----
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# Executor quote polling in seconds (14400 = 4 hours). Minimum 44.
MARKET_DATA_POLL_INTERVAL_SECONDS=14400

# ---- AI advisor (order-service) ----
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- notifications (order-service). Both channels only log while disabled.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false

# ---- ports (not read by the code; must match the manifests, see the header of each *-service.yaml) ----
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082
FRONTEND_PORT=80
