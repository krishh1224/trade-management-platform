# Root .env for docker-compose. Git-ignored: never commit this file.
# Template: .env.example

# --- Docker Compose
COMPOSE_PROFILES=kafka,auth-service,order-service,executor-service,frontend
KAFKA_TOPICS=orders:3:604800000 orders.DLT:1:604800000 trade-events:3:604800000 trade-events.DLT:1:604800000 market-data:3:604800000 market-data.DLT:1:604800000

# --- Database (all services, ETL)
POSTGRES_HOST=database-1.c9scqk8cq82i.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres


# --- Auth / JWT (shared by auth-service, order-service, executor-service)

JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=60

# Signs orders placed by automated strategies (order-service). Must differ from JWT_SECRET.


# --- Spring services (order-service, executor-service)
SPRING_PROFILES_ACTIVE=platform
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Fauxnance market data (order-service, executor-service, ETL)

FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
MARKET_DATA_POLL_INTERVAL_SECONDS=600

# --- AI advisor (order-service). Empty key = advisor disabled.

GEMINI_MODEL=gemini-3.5-flash-lite

# --- Notifications (order-service). Optional; see .env.example to enable real email / push.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
MAIL_HOST=smtp.gmail.com

AUTH_SERVICE_IMAGE=etp-auth-service
ORDER_SERVICE_IMAGE=etp-order-service
EXECUTOR_SERVICE_IMAGE=etp-executor-service
FRONTEND_IMAGE=etp-frontend

AUTH_STUB_HOST=auth-service
AUTH_STUB_PORT=3000
TRADE_API_HOST=order-service
TRADE_API_PORT=8081

PGSSLMODE=no-verify
